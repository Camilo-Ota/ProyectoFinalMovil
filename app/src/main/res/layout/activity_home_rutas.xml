<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/colorPrimary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTituloHomeRutas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sistema de rutas"
            style="@style/HomeRutas.TituloScreen"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSubtituloHomeRutas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccione la operación que desea realizar"
            style="@style/HomeRutas.SubtituloScreen"
            android:layout_marginBottom="28dp" />

        <!-- PASO 01 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASO 01"
                    style="@style/HomeRutas.CardNumero"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Crear ruta"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registrar el nombre de la ruta, descripción y radio de detección."
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnIrCrearRuta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ir a crear ruta"
                    style="@style/HomeRutas.BotonPrimario" />

            </LinearLayout>
        </LinearLayout>

        <!-- PASO 02 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASO 02"
                    style="@style/HomeRutas.CardNumero"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configurar puntos"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar una ruta existente y crear, editar o eliminar sus puntos."
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnIrConfigurarPuntos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ir a configurar puntos"
                    style="@style/HomeRutas.BotonPrimario" />

            </LinearLayout>
        </LinearLayout>

        <!-- PASO 03 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASO 03"
                    style="@style/HomeRutas.CardNumero"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Iniciar recorrido"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elegir una ruta configurada y comenzar el seguimiento del recorrido."
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnIrIniciarRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ir a iniciar recorrido"
                    style="@style/HomeRutas.BotonPrimario" />

            </LinearLayout>
        </LinearLayout>

        <!-- PASO 04 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASO 04"
                    style="@style/HomeRutas.CardNumero"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Historial de recorridos"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consultar los recorridos que ya han sido ejecutados."
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnIrHistorialRecorridos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ir a historial"
                    style="@style/HomeRutas.BotonPrimario" />

            </LinearLayout>
        </LinearLayout>

        <!-- PASO 05 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASO 05"
                    style="@style/HomeRutas.CardNumero"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos de usuario"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Espacio base para registrar o consultar los datos del usuario del recorrido."
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnIrDatosUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ir a datos de usuario"
                    style="@style/HomeRutas.BotonPrimario" />

            </LinearLayout>
        </LinearLayout>

        <!-- PASO 06 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PASO 06"
                    style="@style/HomeRutas.CardNumero"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Blog de conductores"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulta publicaciones, novedades y experiencias compartidas por los conductores."
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="14dp" />

                <Button
                    android:id="@+id/btnIrBlogConductores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ir a blog de conductores"
                    style="@style/HomeRutas.BotonPrimario" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>