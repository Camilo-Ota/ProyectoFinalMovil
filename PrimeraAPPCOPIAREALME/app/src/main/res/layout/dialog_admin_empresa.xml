<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="22dp">

    <!-- Línea decorativa -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/primary"
        android:layout_marginBottom="14dp" />

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo administrador"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Completa la información para registrar un administrador"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="22dp" />

    <!-- Nombre -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre completo"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edtNombreAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ej: Juan Pérez"
        android:inputType="textPersonName"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Correo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Correo electrónico"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edtEmailAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ejemplo@correo.com"
        android:inputType="textEmailAddress"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Contraseña -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contraseña"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edtPasswordAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Mínimo 6 caracteres"
        android:inputType="textPassword"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/input_background"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- Teléfono -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Teléfono"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/edtPhoneAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Opcional"
        android:inputType="phone"
        android:textSize="15sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:background="@drawable/input_background"
        android:padding="12dp" />

</LinearLayout>