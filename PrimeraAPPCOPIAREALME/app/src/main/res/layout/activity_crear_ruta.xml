<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Línea decorativa -->
        <View
            android:layout_width="48dp"
            android:layout_height="5dp"
            android:layout_marginBottom="14dp"
            android:background="@color/primary" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloCrearRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear ruta"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <!-- Subtítulo -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Completa los datos para registrar una nueva ruta"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="26dp" />

        <!-- Card principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:layout_marginBottom="22dp"
            android:elevation="3dp">

            <!-- Barra lateral -->
            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary"
                android:layout_marginEnd="16dp" />

            <!-- Contenido -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Nombre -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nombre de la ruta"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etNombreRuta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: Ruta Norte"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="20dp" />

                <!-- Descripción -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etDescripcionRuta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: Desde bodega hasta punto final"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="textMultiLine"
                    android:minLines="4"
                    android:gravity="top"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:background="@drawable/input_background"
                    android:layout_marginBottom="20dp" />

                <!-- Radio -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Radio de detección (metros)"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etRadioDeteccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ej: 30"
                    android:textColorHint="@color/text_secondary"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:padding="14dp"
                    android:background="@drawable/input_background" />

            </LinearLayout>
        </LinearLayout>

        <!-- Botón -->
        <Button
            android:id="@+id/btnGuardarRuta"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Guardar ruta"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/primary"
            android:elevation="2dp"
            android:layout_marginBottom="18dp" />

        <!-- Estado -->
        <TextView
            android:id="@+id/tvEstadoRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:background="@drawable/bin_redondo_verde"
            android:padding="14dp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>