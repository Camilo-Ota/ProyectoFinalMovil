<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <!-- ACENTO -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/primary"
        android:layout_marginEnd="14dp" />

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- NOMBRE -->
        <TextView
            android:id="@+id/tvNombreRutaRecorridoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta Norte"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <!-- DESCRIPCIÓN -->
        <TextView
            android:id="@+id/tvDescripcionRutaRecorridoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="6dp" />

        <!-- BADGE RADIO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/primary_light"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvRadioRutaRecorridoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio: 30 m"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <!-- BOTÓN -->
        <Button
            android:id="@+id/btnIniciarRecorridoRuta"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="Iniciar recorrido"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/text_white" />

    </LinearLayout>

</LinearLayout>