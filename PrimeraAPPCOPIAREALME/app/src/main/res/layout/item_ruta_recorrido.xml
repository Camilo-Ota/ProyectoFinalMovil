<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/ic_card_accent"
        android:layout_marginEnd="14dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreRutaRecorridoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta Norte"
            style="@style/HomeRutas.CardTitulo"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDescripcionRutaRecorridoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción"
            style="@style/HomeRutas.CardDescripcion"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_radio_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvRadioRutaRecorridoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radio: 30 m"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />
        </LinearLayout>

        <Button
            android:id="@+id/btnIniciarRecorridoRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar recorrido"
            style="@style/HomeRutas.BotonPrimario" />

    </LinearLayout>
</LinearLayout>
