<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:background="@color/colorPrimary"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar punto"
            style="@style/HomeRutas.TituloScreen"
            android:textSize="20sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del punto"
            style="@style/CrearRuta.FieldLabel" />

        <EditText
            android:id="@+id/etNombrePunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Peaje 1"
            android:inputType="textCapWords"
            style="@style/CrearRuta.InputField"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orden del punto"
            style="@style/CrearRuta.FieldLabel" />

        <EditText
            android:id="@+id/etOrdenPunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: 1"
            android:inputType="number"
            style="@style/CrearRuta.InputField"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de punto"
            style="@style/CrearRuta.FieldLabel" />

        <Spinner
            android:id="@+id/spTipoPunto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_background"
            android:padding="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/badge_radio_background"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Coordenadas del punto"
                style="@style/CrearRuta.FieldLabel"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvCoordenadasPunto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Latitud: 0.0\nLongitud: 0.0"
                android:textSize="13sp"
                android:textColor="@color/colorPrimary"
                android:lineSpacingMultiplier="1.5" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
