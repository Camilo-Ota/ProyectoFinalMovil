<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- Barra decorativa -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_marginBottom="14dp"
        android:background="@color/primary" />

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panel Administrador"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <!-- Subtítulo -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de conductores y rutas"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBarAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <!-- Botones principales -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="20dp">

        <Button
            android:id="@+id/btnAsignarBuses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Asignar buses"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:backgroundTint="@color/primary"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAgregarConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Nuevo conductor"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:backgroundTint="@color/secondary"
            android:padding="14dp"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnIrCrearRuta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestionar rutas"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:backgroundTint="@color/surface"
            android:padding="14dp" />

    </LinearLayout>

    <!-- Encabezado sección -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Conductores registrados"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="10dp" />

    <!-- Lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvConductores"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <!-- Cerrar sesión -->
    <Button
        android:id="@+id/btnCerrarSesionAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/error"
        android:backgroundTint="@color/surface"
        android:padding="14dp"
        android:layout_marginTop="14dp" />

</LinearLayout>