<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <!-- HEADER -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_marginBottom="14dp"
        android:background="@color/role_admin_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Panel Administrador"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de conductores y rutas"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/progressBarAdmin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/role_admin_primary"
        android:visibility="gone"
        android:layout_marginBottom="14dp" />

    <!-- 🟦 SECCIÓN: ACCIONES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="18dp"
        android:layout_marginBottom="18dp"
        android:elevation="2dp">

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/role_admin_primary"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCIONES PRINCIPALES"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAsignarBuses"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Asignar buses"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/role_admin_primary"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnAgregarConductor"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="+ Nuevo conductor"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/role_admin_primary"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnIrCrearRuta"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Gestionar rutas"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/role_admin_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- SECCIÓN: CONDUCTORES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="18dp"
        android:layout_marginBottom="14dp"
        android:elevation="2dp">

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/primary_light"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CONDUCTORES REGISTRADOS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvConductores"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- LOGOUT -->
    <Button
        android:id="@+id/btnCerrarSesionAdmin"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="@color/error"
        android:backgroundTint="@color/surface"
        android:layout_marginTop="10dp" />

</LinearLayout>