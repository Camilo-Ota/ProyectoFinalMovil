<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/primary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portal de Usuario"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvBienvenidaPasajero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola, Usuario"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="28dp" />

        <!-- CARD 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:text="Ver rutas en vivo"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="Sigue la ubicación del bus en tiempo real."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnVerRutasEnVivo"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Ver rutas"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_white"/>
        </LinearLayout>

        <!-- CARD 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:text="Chat grupal"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:text="Comunícate con otros usuarios y conductores."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnChat"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Ir al chat"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_white"/>
        </LinearLayout>

        <!-- CARD 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:text="Mis datos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:text="Consulta tu información personal registrada."
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <Button
                android:id="@+id/btnMisDatosUsuario"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Ver mis datos"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_white"/>
        </LinearLayout>

        <!-- LOGOUT (neutral) -->
        <Button
            android:id="@+id/btnCerrarSesionPasajero"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface"/>

    </LinearLayout>
</ScrollView>