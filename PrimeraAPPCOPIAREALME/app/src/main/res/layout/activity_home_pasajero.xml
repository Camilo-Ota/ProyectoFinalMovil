<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/role_user_primary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portal de Usuario"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvBienvenidaPasajero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hola, Usuario"
            android:textSize="15sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="22dp" />

        <!-- 🟦 SECCIÓN 1: RUTAS EN VIVO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/role_user_primary"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="VER RUTAS EN VIVO"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sigue la ubicación del bus en tiempo real."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnVerRutasEnVivo"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Ver rutas"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/role_user_primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 🟩 SECCIÓN 2: CHAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary_light"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="CHAT GRUPAL"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comunícate con otros usuarios y conductores."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnChat"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Ir al chat"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/role_user_primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- 🟨 SECCIÓN 3: MIS DATOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary_dark"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIS DATOS"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulta tu información personal registrada."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnMisDatosUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Ver mis datos"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/role_user_primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnCerrarSesionPasajero"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface"/>

    </LinearLayout>

</ScrollView>