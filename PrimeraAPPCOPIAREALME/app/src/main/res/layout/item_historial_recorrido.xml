<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <!-- ACENTO -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/primary"
        android:layout_marginEnd="14dp" />

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- RUTA -->
        <TextView
            android:id="@+id/tvRutaHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta: Ruta Norte"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <!-- ESTADO BADGE -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/primary_light"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvEstadoHistorialItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estado: finalizado"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- CONDUCTOR -->
        <TextView
            android:id="@+id/tvConductorHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conductor: —"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <!-- BUS -->
        <TextView
            android:id="@+id/tvBusHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bus: —"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- DIVISOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginBottom="8dp" />

        <!-- TIEMPOS -->
        <TextView
            android:id="@+id/tvInicioHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Inicio: 01/01/2026 10:00:00"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvFinHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fin: 01/01/2026 10:30:00"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvTiempoTotalHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiempo total: 00:30:00"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvCantidadPuntosHistorialItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Puntos registrados: 3"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <!-- LINK -->
        <TextView
            android:id="@+id/tvVerDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ver detalle en mapa →"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</LinearLayout>