<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="18dp">

        <!-- Línea decorativa -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/primary"
            android:layout_marginBottom="12dp" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloConfigurarPuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar puntos"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <!-- Nombre ruta -->
        <TextView
            android:id="@+id/tvNombreRutaConfigurar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="6dp" />

        <!-- Instrucción -->
        <TextView
            android:id="@+id/tvInstruccionMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque el mapa para agregar un punto a esta ruta"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="16dp" />

        <!-- Botón -->
        <Button
            android:id="@+id/btnRecargarPuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recargar puntos"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/primary"
            android:paddingTop="14dp"
            android:paddingBottom="14dp" />

    </LinearLayout>

    <!-- MAPA -->
    <fragment
        android:id="@+id/mapConfigurarPuntos"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        map:uiZoomControls="true"
        map:uiCompass="true" />

</LinearLayout>