<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <!-- HEADER -->
    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:layout_marginBottom="14dp"
        android:background="@color/primary" />

    <TextView
        android:id="@+id/tvTituloHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial de recorridos"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvSubtituloHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aquí se muestran los recorridos realizados"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="18dp" />

    <!-- LOADING -->
    <ProgressBar
        android:id="@+id/progressBarHistorial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        android:layout_marginBottom="14dp" />

    <!-- 🟨 EMPTY STATE CARD -->
    <LinearLayout
        android:id="@+id/layoutSinHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp"
        android:elevation="2dp">

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/primary_light"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSinHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No hay recorridos registrados"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Los recorridos completados aparecerán aquí"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- 🟦 LISTA (CARD CONTENEDOR) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:padding="18dp"
        android:elevation="2dp">

        <View
            android:layout_width="5dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:layout_marginEnd="16dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RECORRIDOS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerHistorialRecorridos"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>