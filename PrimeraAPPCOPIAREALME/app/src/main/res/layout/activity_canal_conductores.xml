<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ===== ENCABEZADO ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="56dp"
            android:layout_height="5dp"
            android:background="@color/primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTituloCanal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Canal de conductores"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvSubtituloCanal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comparte novedades, trancones y alertas con tu equipo"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>

    <!-- ===== CAJA NUEVA PUBLICACIÓN ===== -->
    <LinearLayout
        android:id="@+id/layoutPublicar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:elevation="3dp"
        android:padding="18dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp">

        <!-- Avatar + campo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <TextView
                android:id="@+id/tvAvatarPropio"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/avatar_background"
                android:text="YO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                android:gravity="center"
                android:layout_marginEnd="12dp" />

            <EditText
                android:id="@+id/etNuevaPublicacion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/input_background"
                android:hint="¿Qué quieres reportar?"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top"
                android:padding="14dp"
                android:inputType="textMultiLine" />
        </LinearLayout>

        <!-- Tags -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tagAlerta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alerta"
                    android:background="@drawable/tag_selected_background"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp"
                    android:textColor="@color/text_white"
                    android:backgroundTint="@color/primary" />

                <TextView
                    android:id="@+id/tagTrancon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trancón"
                    android:background="@drawable/tag_normal_background"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Info"
                    android:background="@drawable/tag_normal_background"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tagGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="General"
                    android:background="@drawable/tag_normal_background"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Botón -->
        <Button
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Publicar"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

    <!-- ===== FILTROS ===== -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filtroTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todos"
                android:background="@drawable/tag_selected_background"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/primary" />

            <TextView
                android:id="@+id/filtroAlertas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alertas"
                android:background="@drawable/tag_normal_background"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filtroTrancons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trancones"
                android:background="@drawable/tag_normal_background"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/filtroInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Info"
                android:background="@drawable/tag_normal_background"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ===== LOADING ===== -->
    <ProgressBar
        android:id="@+id/progressBarCanal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        android:layout_marginBottom="10dp" />

    <!-- ===== EMPTY STATE ===== -->
    <LinearLayout
        android:id="@+id/layoutSinPublicaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_background"
        android:elevation="2dp"
        android:padding="36dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone">

        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/ic_empty_circle"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sin publicaciones aún"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sé el primero en reportar algo"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ===== LISTA ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPublicaciones"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp"
        android:clipToPadding="false" />

</LinearLayout>