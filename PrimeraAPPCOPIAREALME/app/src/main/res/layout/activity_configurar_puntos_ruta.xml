<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- ===== HEADER ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="18dp">

        <View
            android:layout_width="56dp"
            android:layout_height="5dp"
            android:background="@color/primary"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvTituloConfigurarPuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurar puntos"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvNombreRutaConfigurar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvInstruccionMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toque el mapa para agregar un punto a esta ruta"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnRecargarPuntos"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Recargar puntos"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/primary" />

    </LinearLayout>

    <!-- ===== MAPA ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/card_background"
        android:elevation="3dp"
        android:padding="6dp">

        <fragment
            android:id="@+id/mapConfigurarPuntos"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            map:uiZoomControls="true"
            map:uiCompass="true" />

    </LinearLayout>

    <!-- ===== TITULO LISTA ===== -->
    <TextView
        android:id="@+id/tvTituloListaPuntos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Puntos de la ruta"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp" />

    <!-- ===== EMPTY STATE ===== -->
    <LinearLayout
        android:id="@+id/layoutSinPuntos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_background"
        android:elevation="2dp"
        android:padding="28dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="📍"
            android:textSize="24sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvSinPuntos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no hay puntos registrados"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Toca el mapa para agregar el primero"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center" />

    </LinearLayout>

    <!-- ===== LISTA ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPuntosRuta"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:clipToPadding="false" />

</LinearLayout>