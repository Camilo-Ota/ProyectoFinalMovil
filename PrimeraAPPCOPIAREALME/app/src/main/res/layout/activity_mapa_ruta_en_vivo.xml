<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- MAPA -->
    <fragment
        android:id="@+id/mapFragmentPasajero"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HEADER SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:background="#F2FFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:elevation="6dp">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreRutaMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre de la ruta"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seguimiento en tiempo real"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- PANEL INFERIOR -->
    <LinearLayout
        android:id="@+id/cardInfoBus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/card_background"
        android:padding="18dp"
        android:layout_margin="14dp"
        android:visibility="gone"
        android:elevation="8dp">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/primary"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Estado -->
            <TextView
                android:id="@+id/tvEstadoBusMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 Bus en servicio"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <!-- Paradero -->
            <TextView
                android:id="@+id/tvParaderoMasCercanoMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Paradero: —"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <!-- Tiempo caminando -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 Tú llegas en: "
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTiempoWalkingMapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculando..."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/success" />
            </LinearLayout>

            <!-- Tiempo del bus -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚌 Bus llega en: "
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvTiempoEstimadoMapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculando..."
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <!-- Conductor -->
            <TextView
                android:id="@+id/tvInfoConductorMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conductor: —"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <!-- Hint -->
            <TextView
                android:id="@+id/tvHintParadero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Toca un paradero en el mapa para ver información"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>