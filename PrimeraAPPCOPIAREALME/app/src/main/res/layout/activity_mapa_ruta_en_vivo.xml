<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- MAPA -->
    <fragment
        android:id="@+id/mapFragmentPasajero"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HEADER superpuesto arriba -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#EEFFFFFF"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/ic_card_accent"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvNombreRutaMapa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre de la ruta"
            style="@style/HomeRutas.TituloScreen"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- PANEL inferior con info del bus -->
    <LinearLayout
        android:id="@+id/cardInfoBus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/card_background"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:visibility="gone">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@drawable/ic_card_accent"
            android:layout_marginEnd="14dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Estado del bus -->
            <TextView
                android:id="@+id/tvEstadoBusMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🟢 Bus en servicio"
                style="@style/HomeRutas.CardTitulo"
                android:textSize="15sp"
                android:layout_marginBottom="6dp" />

            <!-- Paradero más cercano -->
            <TextView
                android:id="@+id/tvParaderoMasCercanoMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📍 Paradero: —"
                style="@style/HomeRutas.CardDescripcion"
                android:layout_marginBottom="4dp" />

            <!-- Tiempo caminando al paradero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚶 Tú llegas en: "
                    android:textSize="13sp"
                    android:textColor="@color/colorTextoTitulo"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTiempoWalkingMapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculando..."
                    android:textSize="13sp"
                    android:textColor="#2E7D32"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Tiempo estimado del bus -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚌 Bus llega en: "
                    android:textSize="13sp"
                    android:textColor="@color/colorTextoTitulo"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTiempoEstimadoMapa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculando..."
                    android:textSize="13sp"
                    android:textColor="@color/colorPrimary"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Conductor -->
            <TextView
                android:id="@+id/tvInfoConductorMapa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Conductor: —"
                style="@style/HomeRutas.CardDescripcion" />

            <!-- Hint de paradero seleccionable -->
            <TextView
                android:id="@+id/tvHintParadero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💡 Toca un paradero en el mapa para ver su info"
                android:textSize="11sp"
                android:textColor="#888888"
                android:layout_marginTop="6dp" />

        </LinearLayout>
    </LinearLayout>


</androidx.coordinatorlayout.widget.CoordinatorLayout>