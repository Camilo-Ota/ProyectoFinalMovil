<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111A26">

    <!-- ══════════════════════════════════════════
         MAPA — ocupa toda la pantalla
    ══════════════════════════════════════════ -->
    <fragment
        android:id="@+id/mapNavConductor"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ══════════════════════════════════════════
         HEADER FLOTANTE — nombre de la ruta
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/headerNavConductor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="40dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvNombreRutaNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ruta"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/tvProgresoNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0 paradas"
            android:textColor="#90CAF9"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         BOTONES FLOTANTES DERECHA
         - Centrar en conductor
         - Ver ruta completa
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="280dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Centrar — oculto por defecto, aparece cuando el usuario mueve el mapa -->
        <ImageButton
            android:id="@+id/btnCentrarMapa"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="#CC1E2D3D"
            android:src="@android:drawable/ic_menu_mylocation"
            android:tint="#1E88E5"
            android:visibility="gone"
            android:layout_marginBottom="10dp"
            android:contentDescription="Centrar" />

        <!-- Ver ruta completa -->
        <ImageButton
            android:id="@+id/btnVerRutaCompleta"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="#CC1E2D3D"
            android:src="@android:drawable/ic_dialog_map"
            android:tint="#B0BEC5"
            android:contentDescription="Ver ruta completa" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         BANNER LLEGANDO — aparece al acercarse
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutLlegandoNav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#DD00B248"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/panelNavConductor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚏   LLEGANDO AL PARADERO"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         PANEL INFERIOR — info de navegación
         Diseño estilo Waze/Google Maps
    ══════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/panelNavConductor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Tipo del paradero -->
        <TextView
            android:id="@+id/tvTipoParaderoNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Paradero"
            android:textColor="#90CAF9"
            android:textSize="12sp"
            android:letterSpacing="0.04"
            android:layout_marginBottom="4dp" />

        <!-- Nombre del paradero — grande, legible a un vistazo -->
        <TextView
            android:id="@+id/tvParaderoActualNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando..."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="14dp" />

        <!-- Fila: distancia + tiempo estimado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- Distancia -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#22FFFFFF"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCIA"
                    android:textColor="#78909C"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvDistanciaNav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Tiempo estimado -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#22FFFFFF"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIEMPO EST."
                    android:textColor="#78909C"
                    android:textSize="10sp"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/tvTiempoEstNav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFD54F"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Separador -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- Siguiente paradero -->
        <TextView
            android:id="@+id/tvSiguienteParaderoNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Siguiente: --"
            android:textColor="@color/blanco"
            android:textSize="13sp"
            android:drawablePadding="6dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>