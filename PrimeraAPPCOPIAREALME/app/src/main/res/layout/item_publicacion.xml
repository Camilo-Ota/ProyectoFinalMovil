<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvAvatarPublicacion"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@color/primary_light"
            android:text="?"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:gravity="center"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreAutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conductor"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvTiempoPublicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hace un momento"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCategoriaPublicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General"
            android:background="@color/primary"
            android:textColor="@color/text_white"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

    </LinearLayout>

    <!-- CONTENIDO -->
    <TextView
        android:id="@+id/tvTextoPublicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contenido de la publicación"
        android:textSize="13sp"
        android:textColor="@color/text_primary"
        android:lineSpacingMultiplier="1.3" />

    <!-- BOTÓN VER MAPA -->
    <TextView
        android:id="@+id/tvVerMapa"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Mapa"
        android:textSize="13sp"
        android:textColor="@color/primary"
        android:gravity="center"
        android:padding="8dp"
        android:layout_marginTop="8dp" />

</LinearLayout>