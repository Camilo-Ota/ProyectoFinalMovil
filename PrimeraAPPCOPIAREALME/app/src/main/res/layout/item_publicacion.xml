<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_publicacion.xml -->
<!-- Tarjeta individual para cada publicación del canal de conductores -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_background"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <!-- Fila superior: avatar + nombre + tiempo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <!-- Avatar con iniciales del conductor -->
        <TextView
            android:id="@+id/tvAvatarPublicacion"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/avatar_background"
            android:text="?"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:gravity="center"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nombre del conductor -->
            <TextView
                android:id="@+id/tvNombreAutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conductor"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/design_default_color_primary_variant" />

            <!-- Tiempo de publicación -->
            <TextView
                android:id="@+id/tvTiempoPublicacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="hace un momento"
                android:textSize="11sp"
                android:textColor="@color/colorGris" />
        </LinearLayout>

        <!-- Badge de categoría (Alerta / Trancón / Info / General) -->
        <TextView
            android:id="@+id/tvCategoriaPublicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="General"
            android:background="@drawable/tag_selected_background"
            android:textColor="@color/colorBlanco"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>

    <!-- Texto de la publicación -->
    <TextView
        android:id="@+id/tvTextoPublicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Contenido de la publicación"
        android:textSize="13sp"
        android:textColor="@color/negro"
        android:lineSpacingMultiplier="1.3" />

</LinearLayout>