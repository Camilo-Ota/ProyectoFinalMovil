<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <!-- ACENTO -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/primary"
        android:layout_marginEnd="12dp" />

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- NOMBRE -->
        <TextView
            android:id="@+id/tvNombrePuntoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Punto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <!-- BADGE TIPO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/primary_light"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvTipoPuntoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo: origen"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />

        </LinearLayout>

        <!-- COORDENADAS -->
        <TextView
            android:id="@+id/tvCoordenadasPuntoItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lat: 0.0 | Lng: 0.0"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEditarPunto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Editar"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/text_white"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnEliminarPunto"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Eliminar"
                android:textSize="12sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/error"
                android:textColor="@color/text_white" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>