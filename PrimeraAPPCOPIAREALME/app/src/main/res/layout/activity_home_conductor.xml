<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <View
            android:layout_width="48dp"
            android:layout_height="4dp"
            android:background="@color/primary"
            android:layout_marginBottom="14dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Panel del Conductor"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una opción"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="24dp"/>

        <!-- CARD 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="14dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opción 01"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Iniciar recorrido"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Elige una ruta y comienza el seguimiento GPS."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btnIrIniciarRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Continuar"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="14dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary_light"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opción 02"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Historial de recorridos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Consulta tus recorridos anteriores."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btnIrHistorialRecorridos"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Ver historial"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="14dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary_dark"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opción 03"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mis datos"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Actualiza tu información personal."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btnIrDatosUsuario"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Ver datos"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="18dp"
            android:layout_marginBottom="20dp"
            android:elevation="2dp">

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="@color/primary_light"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Opción 04"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chat grupal"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Comunicación entre conductores."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="14dp"/>

                <Button
                    android:id="@+id/btnIrBlogConductores"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Abrir chat"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/text_white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnCerrarSesionConductor"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Cerrar sesión"
            android:textAllCaps="false"
            android:backgroundTint="@color/surface"
            android:textColor="@color/text_primary"/>

    </LinearLayout>

</ScrollView>