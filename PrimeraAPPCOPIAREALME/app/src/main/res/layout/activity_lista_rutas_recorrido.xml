<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="48dp"
        android:layout_height="5dp"
        android:background="@color/primary"
        android:layout_marginBottom="14dp" />

    <TextView
        android:id="@+id/tvTituloRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rutas para recorrido"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="6dp" />

    <TextView
        android:id="@+id/tvSubtituloRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccione una ruta para iniciar el recorrido"
        android:textSize="15sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="20dp" />

    <ProgressBar
        android:id="@+id/progressBarRutasRecorrido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/primary"
        android:visibility="gone"
        android:layout_marginBottom="14dp" />

    <LinearLayout
        android:id="@+id/layoutSinRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_background"
        android:padding="32dp"
        android:visibility="gone"
        android:layout_marginBottom="18dp">

        <View
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/ic_empty_circle"
            android:layout_marginBottom="14dp" />

        <TextView
            android:id="@+id/tvSinRutasRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay rutas disponibles"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Las rutas activas aparecerán aquí"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="10dp" />

</LinearLayout>