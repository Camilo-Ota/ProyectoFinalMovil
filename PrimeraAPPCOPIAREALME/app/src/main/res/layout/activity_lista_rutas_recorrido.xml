<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTituloRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rutas para recorrido"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/tvSubtituloRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Seleccione una ruta para iniciar el recorrido"
        android:textSize="15sp"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/progressBarRutasRecorrido"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvSinRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay rutas disponibles"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRutasRecorrido"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>