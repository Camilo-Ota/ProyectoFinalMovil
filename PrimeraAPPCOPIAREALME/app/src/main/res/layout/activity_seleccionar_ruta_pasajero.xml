<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="28dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/colorPrimary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Rutas disponibles"
        style="@style/HomeRutas.TituloScreen"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona la ruta que deseas seguir en tiempo real"
        style="@style/HomeRutas.SubtituloScreen"
        android:layout_marginBottom="20dp" />

    <ProgressBar
        android:id="@+id/progressBarRutasPasajero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:indeterminateTint="@color/colorPrimary"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:id="@+id/layoutSinRutasPasajero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/card_background"
        android:padding="32dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/ic_empty_circle"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No hay rutas disponibles"
            android:textSize="15sp"
            android:textColor="@color/colorGris"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aún no hay rutas configuradas en el sistema"
            android:textSize="12sp"
            android:textColor="@color/colorGris"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRutasPasajero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</LinearLayout>