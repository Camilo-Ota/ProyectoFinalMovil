<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <!-- Barra decorativa -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/primary"
            android:layout_marginBottom="12dp" />

        <!-- Título -->
        <TextView
            android:id="@+id/tvTituloRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recorrido"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="20dp" />

        <!-- CARD PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <!-- Barra lateral -->
            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/primary"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRutaRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruta:"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:id="@+id/tvEstadoRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: pendiente"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvCantidadPuntosRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puntos: 0"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPuntoSiguienteRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Siguiente punto: --"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvTiempoInicioRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inicio: --"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvUbicacionActualRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ubicación actual: --"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvProgresoRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Progreso: 0/0"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>

        </LinearLayout>

        <!-- BOTÓN INICIAR -->
        <Button
            android:id="@+id/btnIniciarRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar recorrido"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:backgroundTint="@color/primary"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="12dp" />

        <!-- BOTÓN MAPA -->
        <Button
            android:id="@+id/btnNavegacionConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver mapa de navegación"
            android:enabled="false"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/primary_dark"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="12dp" />

        <!-- BOTÓN FINALIZAR -->
        <Button
            android:id="@+id/btnFinalizarManualRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar manualmente"
            android:enabled="false"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/primary"
            android:backgroundTint="@color/surface"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="26dp" />

        <!-- Separador -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/primary_light"
            android:layout_marginBottom="12dp" />

        <!-- Título sección -->
        <TextView
            android:id="@+id/tvTituloPuntosRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seguimiento de puntos"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="14dp" />

        <!-- Recycler -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPuntosSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

    </LinearLayout>

</ScrollView>