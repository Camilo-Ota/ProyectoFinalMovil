<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="28dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/colorPrimary"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTituloRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recorrido"
            style="@style/HomeRutas.TituloScreen"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/ic_card_accent"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvRutaRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ruta:"
                    style="@style/HomeRutas.CardTitulo"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:id="@+id/tvEstadoRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado: pendiente"
                    style="@style/CrearRuta.FieldLabel"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCantidadPuntosRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Puntos: 0"
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvPuntoSiguienteRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Siguiente punto: --"
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvTiempoInicioRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Inicio: --"
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvUbicacionActualRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ubicación actual: --"
                    style="@style/HomeRutas.CardDescripcion"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvProgresoRecorrido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Progreso: 0/0"
                    style="@style/HomeRutas.CardDescripcion" />

            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnIniciarRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Iniciar recorrido"
            style="@style/HomeRutas.BotonPrimario"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnNavegacionConductor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver mapa de navegación"
            android:enabled="false"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnFinalizarManualRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Finalizar manualmente"
            android:enabled="false"
            android:background="@drawable/btn_secondary"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:background="@color/colorPrimaryLight"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvTituloPuntosRecorrido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seguimiento de puntos"
            style="@style/HomeRutas.CardTitulo"
            android:layout_marginBottom="12dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerPuntosSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
