<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <Button
            android:id="@+id/botonborrar"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="0"
            android:layout_column="0"
            android:layout_margin="3dp"
            android:onClick="borrar"
            android:text="CA"
            android:textSize="24sp"
            android:textColor="@color/blanco"
            android:background="@drawable/bin_redondo_negro"
            />

        <Button
            android:id="@+id/boton1"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="0"
            android:layout_column="1"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="1"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"

            />

        <Button
            android:id="@+id/boton2"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="0"
            android:layout_column="2"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="2"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/boton3"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="0"
            android:layout_column="3"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="3"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/botonsuma"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="1"
            android:layout_column="0"
            android:layout_margin="3dp"
            android:onClick="cambiaroperador"
            android:text="+"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_azul"
            />
        <Button
            android:id="@+id/boton4"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="1"
            android:layout_column="1"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="4"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/boton5"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="1"
            android:layout_column="2"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="5"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/boton6"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="1"
            android:layout_column="3"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="6"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/botonresta"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="2"
            android:layout_column="0"
            android:layout_margin="3dp"
            android:onClick="cambiaroperador"
            android:text="-"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_negro"
            android:textColor="@color/blanco"
            />
        <Button
            android:id="@+id/boton7"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="2"
            android:layout_column="1"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="7"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"

            />
        <Button
            android:id="@+id/boton8"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="2"
            android:layout_column="2"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="8"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />

        <Button
            android:id="@+id/boton9"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="2"
            android:layout_column="3"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="9"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/botonmultiplicar"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="3"
            android:layout_column="0"
            android:layout_margin="3dp"
            android:onClick="cambiaroperador"
            android:text="x"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_verde"
            />
        <Button
            android:id="@+id/botonporcentaje"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="3"
            android:layout_column="1"
            android:layout_margin="3dp"
            android:onClick="cambiaroperador"
            android:text="%"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_gris"
            />
        <Button
            android:id="@+id/boton0"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="3"
            android:layout_column="2"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="0"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_beige"
            />
        <Button
            android:id="@+id/botonborrado"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="3"
            android:layout_column="3"
            android:layout_margin="3dp"
            android:onClick="borrar"
            android:text="c"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_gris"
            />
        <Button
            android:id="@+id/botondividir"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="4"
            android:layout_column="0"
            android:layout_margin="3dp"
            android:onClick="cambiaroperador"
            android:text="÷"
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_blanco"
            />
        <Button
            android:id="@+id/botonpunto"
            android:layout_width="wrap_content"
            android:layout_height="100dp"
            android:layout_row="4"
            android:layout_column="1"
            android:layout_margin="3dp"
            android:onClick="seleccionarnumero"
            android:text="."
            android:textSize="24sp"
            android:background="@drawable/bin_redondo_blanco"
            />

        <Button
            android:id="@+id/botonigual"
            android:layout_row="4"
            android:layout_column="2"
            android:layout_columnWeight="2"
            android:layout_columnSpan="2"
            android:text="="
            android:textSize="30sp"
            android:onClick="igual"
            android:background="@drawable/bin_redondo_rojo"
            android:height="100dp"
            />


    </GridLayout>
</LinearLayout>