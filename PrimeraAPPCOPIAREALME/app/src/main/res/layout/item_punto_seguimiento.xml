<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutItemPuntoSeguimiento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/surface"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <!-- ACENTO -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/primary"
        android:layout_marginEnd="12dp" />

    <!-- CONTENIDO -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- TITULO -->
        <TextView
            android:id="@+id/tvNombrePuntoSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Punto"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="6dp" />

        <!-- BADGES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- TIPO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/primary_light"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvTipoPuntoSeguimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tipo: origen"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </LinearLayout>

            <!-- ESTADO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/primary_light"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tvEstadoPuntoSeguimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estado: pendiente"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />
            </LinearLayout>

        </LinearLayout>

        <!-- TIEMPOS -->
        <TextView
            android:id="@+id/tvTiempoDesdeAnteriorSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiempo desde anterior: --"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="3dp" />

        <TextView
            android:id="@+id/tvTiempoAcumuladoSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tiempo acumulado: --"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</LinearLayout>