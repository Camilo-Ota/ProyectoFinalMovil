<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardBusSeleccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- Ícono bus -->
            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🚌"
                android:textSize="22sp"
                android:gravity="center"
                android:background="#F0F4F8"
                android:layout_marginEnd="12dp" />

            <!-- Info del bus -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvPlacaSeleccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A2A35"
                        android:layout_marginEnd="8dp" />

                    <!-- Badge "Actual" -->
                    <TextView
                        android:id="@+id/tvBadgeActual"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Actual"
                        android:textSize="10sp"
                        android:textColor="#1995AD"
                        android:textStyle="bold"
                        android:background="@drawable/badge_background"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvModeloSeleccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#78909C"
                    android:layout_marginTop="2dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tvCapSeleccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#90A4AE"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:id="@+id/tvEstadoSeleccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#2E7D32"
                        android:textStyle="bold" />

                </LinearLayout>
            </LinearLayout>

            <!-- Flecha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="24sp"
                android:textColor="#B0BEC5"
                android:layout_marginStart="8dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>