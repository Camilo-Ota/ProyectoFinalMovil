<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="32dp"
    android:paddingBottom="20dp">

    <!-- Barra superior decorativa -->
    <View
        android:layout_width="56dp"
        android:layout_height="5dp"
        android:background="@color/primary"
        android:layout_marginBottom="16dp" />

    <!-- Título -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asignar buses"
        style="@style/HomeRutas.TituloScreen"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="28sp"
        android:layout_marginBottom="8dp" />

    <!-- Descripción -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Asigna o cambia el bus de cada conductor"
        style="@style/HomeRutas.CardDescripcion"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="24dp" />

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progressBarAsignar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone" />

    <!-- Estado vacío -->
    <TextView
        android:id="@+id/tvSinConductoresBus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No hay conductores en tu empresa"
        android:textColor="@color/text_secondary"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="20dp"
        android:background="@color/surface"
        android:layout_marginTop="24dp"
        android:visibility="gone" />

    <!-- Card principal -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConductoresBus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:clipToPadding="false" />

    </androidx.cardview.widget.CardView>

</LinearLayout>