<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">

    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@drawable/ic_card_accent"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreRutaItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre punto"
            style="@style/HomeRutas.CardTitulo"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_radio_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvMarca"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLongitudyLatitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latitud y Longitud"
            style="@style/HomeRutas.CardDescripcion"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/linearbotones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/editarr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Editar"
                style="@style/HomeRutas.BotonPrimario"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/eliminarr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Eliminar"
                android:background="@drawable/btn_secondary"
                android:textColor="@color/colorPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />

        </LinearLayout>
    </LinearLayout>
</LinearLayout>
